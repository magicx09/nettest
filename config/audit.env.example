# ---------------------------------------------------------------------------
# proxy-node-audit / 环境变量示例
# 复制为 config/audit.env 后按需填写，再用 `make batch` 等目标自动加载。
#   cp config/audit.env.example config/audit.env
# 只有【带 Key 的数据源】需要这些变量；不填也能跑（走免费源）。
# config/audit.env 已在 .gitignore 里，不会被提交。
# ---------------------------------------------------------------------------

# ---- 订阅 / 配置 ----------------------------------------------------------
# Clash/Mihomo 格式的本地文件路径，或订阅 URL（务必带 &flag=meta）
PNQ_CONFIG=""
# 也可以只给订阅地址，02 会用 -c 直接吃
PNQ_SUB=""

# 节点名过滤正则与屏蔽关键词（| 分隔）
PNQ_FILTER=".*"
PNQ_BLOCK="剩余流量|剩余|重置|距离下次|套餐|到期|过期|官网|订阅|续费|流量|Expire|Expired|Traffic|Website|Subscribe"

# 采样与间隔（稳定性置信度取决于样本数）
PNQ_SAMPLES="3"
PNQ_INTERVAL="2"

# ---- 可选：IP 风险数据源 API Key ------------------------------------------
# 全部可选。多一个源，共识结论就更稳一点。
# AbuseIPDB  https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=""
# IPQualityScore  https://www.ipqualityscore.com/create-account
IPQS_API_KEY=""
# ipregistry  https://dashboard.ipregistry.co/signup
IPREGISTRY_API_KEY=""
# IP2Location.io  https://www.ip2location.io/
IP2LOCATION_API_KEY=""
# proxycheck.io  https://proxycheck.io/dashboard
PROXYCHECK_KEY=""

# ---- 上游脚本环境 ----------------------------------------------------------
# 上游 IPQuality/NetQuality 需要 bash 4+。macOS 自带的是 3.2，脚本会自动去找
# /opt/homebrew/bin/bash（brew install bash）。装在别处就在这里指定。
PNQ_BASH=""
# 上游 RegionRestrictionCheck 需要 grep -P（GNU grep）。装了默认会自动找（ggrep / gnubin）。
# 想手动指定且目录里有 grep 就用这个。
PNQ_GNUGREP_DIR=""

# ---- 可选：链路取证 --------------------------------------------------------
# 入口（域名:端口），03-chain-trace.sh 会用
PNQ_ENTRY=""
# Globalping 探针位置（逗号分隔）
PNQ_FROM="China,Japan,United States,Germany"
PNQ_GP_LIMIT="2"

# ---- CLI 认证（GitHub Actions 里用 Secret 注入）----------------------------
# Globalping 提高配额用（可选）
GLOBALPING_TOKEN=""
