#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# uuidgen shim —— MSYS2(Windows) 上没有 uuidgen，而上游 RegionRestrictionCheck
# 要用它生成一个随机 UUID。
#
# 优先级：python3 -> /dev/urandom + od -> bash $RANDOM。
# 三者都不需要额外安装，最后一级纯粹是「有总比没有好」的兜底。
# ---------------------------------------------------------------------------
set -uo pipefail

if command -v python3 >/dev/null 2>&1; then
  python3 -c 'import uuid;print(str(uuid.uuid4()).upper())' 2>/dev/null && exit 0
fi
if command -v python >/dev/null 2>&1; then
  python -c 'import uuid;print(str(uuid.uuid4()).upper())' 2>/dev/null && exit 0
fi
if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
  hex="$(od -An -tx1 -N16 /dev/urandom 2>/dev/null | tr -d ' \n')"
  if [ ${#hex} -ge 32 ]; then
    printf '%s-%s-4%s-%s-%s\n' \
      "$(printf '%s' "$hex" | cut -c1-8)" \
      "$(printf '%s' "$hex" | cut -c9-12)" \
      "$(printf '%s' "$hex" | cut -c14-16)" \
      "$(printf '%s' "$hex" | cut -c17-20)" \
      "$(printf '%s' "$hex" | cut -c21-32)" | tr 'a-f' 'A-F'
    exit 0
  fi
fi

printf '%04X%04X-%04X-4%03X-%04X-%04X%04X%04X\n' \
  "$RANDOM" "$RANDOM" "$RANDOM" "$((RANDOM % 4096))" \
  "$((RANDOM % 16384))" "$RANDOM" "$RANDOM" "$RANDOM"
