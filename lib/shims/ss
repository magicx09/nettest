#!/bin/sh
# ---------------------------------------------------------------------------
# ss shim —— macOS 没有 iproute2 的 ss。
#
# 上游脚本里只有一处用它（IPQuality 判断「本机有没有监听 25 端口」）：
#   ss -tano | grep -q ":25\b" && smail[local]=2 || smail[local]=0
# 缺了它会往日志里打一行 "ss: command not found"。
#
# 这里用 netstat 近似实现，并把地址从 127.0.0.1.25 形式转成 127.0.0.1:25，
# 这样上游的 ":25\b" 正则能正常工作。
# ---------------------------------------------------------------------------
PROTO=tcp
case " $* " in
  *u*) PROTO=udp ;;
esac

if ! command -v netstat >/dev/null 2>&1; then
  exit 0
fi

# macOS: netstat -an -p tcp
#   Proto Recv-Q Send-Q  Local Address          Foreign Address        (state)
netstat -an -p "$PROTO" 2>/dev/null | awk '
  NR == 1 { next }
  NF >= 4 {
    split($4, p, ".")
    if (length(p) > 1) {
      port = p[length(p)]
      sub("\\." port "$", "", $4)
      $4 = $4 ":" port
    }
    state = (NF >= 6 ? $6 : "")
    print state "\t" $1 "\t" $4
  }'
